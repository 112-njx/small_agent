# 复制本文件为 .env 并填写真实值：cp .env.example .env（Windows: copy .env.example .env）
# .env 已被 .gitignore 忽略，不会提交到仓库。

# 【必需】LLM API Key（也可设置同名环境变量；未设置时回退读取 OPENAI_API_KEY）
LLM_API_KEY=

# 【可选】OpenAI 兼容接口的 Base URL，默认 https://api.openai.com/v1
# LLM_BASE_URL=https://api.openai.com/v1

# 【可选】模型名，默认 gpt-4o-mini
# LLM_MODEL=gpt-4o-mini

# 【可选】Agent 单次任务最大循环轮次（正整数），默认 10
# AGENT_MAX_ROUNDS=10

# 【可选】上下文阈值（估计 token 数，正整数）：超过后对最旧片段做基础压缩，默认 8000
# AGENT_CONTEXT_THRESHOLD=8000

# 【可选】日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL，默认 INFO
# LOG_LEVEL=INFO

# 【可选】日志目录（相对项目根目录），默认 logs
# AGENT_LOG_DIR=logs
